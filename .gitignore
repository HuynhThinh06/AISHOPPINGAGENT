# ==========================================
# AI Shopping Agent — .gitignore
# ==========================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.env.local

# --- Java / Maven ---
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
backend/.mvn/wrapper/maven-wrapper.jar

# --- Node / React ---
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDE & Editors ---
.idea/
**/.idea/
*.iml
*.iws
*.ipr
.vscode/
**/.vscode/
!.vscode/extensions.json
.settings/
.project
.classpath
*.suo
*.user
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS Specific ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & Temp ---
*.log
logs/
**/logs/
tmp/
temp/
